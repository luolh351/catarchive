/* 底部留出固定底栏的空间，避免最后一段文字被遮住 */
.about { padding: 24rpx 0 280rpx; }
/* 顶部共建说明卡片 */
.notice {
  background: linear-gradient(135deg, #EDF3FF, #F8FAFF);
  border-left: 8rpx solid var(--primary);
  border-radius: 20rpx; padding: 26rpx 26rpx 24rpx;
  margin: 4rpx 4rpx 8rpx;
  box-shadow: 0 6rpx 20rpx rgba(47,111,219,.08);
}
.notice .nt { font-size: 28rpx; font-weight: 600; color: var(--primary); margin-bottom: 14rpx; }
.notice .nb { font-size: 26rpx; line-height: 1.8; color: #34465C; }
/* 投喂须知警示卡片 */
.warn {
  margin: 20rpx 4rpx 8rpx;
  background: linear-gradient(135deg, #FFF6EC, #FFFCF8);
  border-left: 8rpx solid #E8833A;
  border-radius: 20rpx; padding: 26rpx 26rpx 24rpx;
  box-shadow: 0 6rpx 20rpx rgba(232,131,58,.08);
}
.warn .wt { font-size: 26rpx; font-weight: 600; color: #C4632A; margin-bottom: 10rpx; }
.warn .wi { font-size: 26rpx; line-height: 1.8; color: #34465C; margin-bottom: 18rpx; }
.warn .wok {
  font-size: 26rpx; color: #2E8F5B; background: #EDF8F1;
  border-radius: 14rpx; padding: 16rpx 18rpx;
}
.about .h { font-size: 28rpx; font-weight: 600; margin: 28rpx 4rpx 12rpx; color: #182A44; }
.about .p { font-size: 27rpx; line-height: 1.8; color: #34465C; margin-bottom: 8rpx; }
/* 固定底栏：关于页是 tabBar 页，页面视口已排除 tabBar，bottom:0 即贴其上方 */
.footbar {
  position: fixed; left: 0; right: 0; bottom: 0; z-index: 99;
  padding: 18rpx 24rpx;
  padding-bottom: calc(18rpx + env(safe-area-inset-bottom));
  background: #fff;
  box-shadow: 0 -6rpx 24rpx rgba(24,42,68,.08);
}
.fbtn {
  text-align: center; border-radius: 24rpx;
  padding: 22rpx 0; font-size: 29rpx;
  background: var(--primary); color: #fff;
}
.fbtn + .fbtn { margin-top: 16rpx; }   /* 竖排按钮间距 */
.fbtn.ghost { background: #EDF3FF; color: var(--primary); }
