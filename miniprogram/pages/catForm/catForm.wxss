/* 表单样式复用 app.wxss 公共类 */
.custom { margin-top: 16rpx; }

/* 两处封面预览：圆形（首页）+ 横向（卡片/详情大图），点击进入框选 */
.covers { display: flex; gap: 24rpx; align-items: flex-end; margin-top: 16rpx; }
.covitem { display: flex; flex-direction: column; align-items: center; gap: 10rpx; }
.covitem-wide { flex: 1; min-width: 0; align-items: stretch; }
.covhome {
  width: 132rpx; height: 132rpx; border-radius: 50%; overflow: hidden;
  display: flex; align-items: center; justify-content: center;
  border: 2rpx dashed #C9D4E4; box-sizing: border-box; background: #F4F6FA;
}
.covhome image { width: 100%; height: 100%; }
.covcard {
  width: 100%; height: 132rpx; border-radius: 18rpx; overflow: hidden;
  display: flex; align-items: center; justify-content: center;
  border: 2rpx dashed #C9D4E4; box-sizing: border-box; background: #F4F6FA;
}
.covcard image { width: 100%; height: 100%; }
.covph { font-size: 22rpx; color: #9AA3AD; }
.covlab { font-size: 22rpx; color: #8a8f99; text-align: center; }
.covclear { font-size: 22rpx; color: #C0392B; text-align: center; margin-top: 16rpx; }

/* 选择封面原图的半屏浮层 */
.covmask {
  position: fixed; left: 0; right: 0; top: 0; bottom: 0; z-index: 999;
  background: rgba(16,24,40,.45); display: flex; align-items: flex-end;
}
.covsheet {
  width: 100%; background: #fff; box-sizing: border-box;
  border-radius: 28rpx 28rpx 0 0; padding: 28rpx 28rpx 40rpx;
}
.covst { font-size: 30rpx; font-weight: 600; color: #182A44; }
.covskip { font-size: 22rpx; color: #8a8f99; margin-top: 8rpx; line-height: 1.5; }
.covgrid { display: flex; flex-wrap: wrap; gap: 16rpx; margin-top: 20rpx; }
.covcell { width: 140rpx; height: 140rpx; border-radius: 16rpx; overflow: hidden; background: #F4F6FA; }
.covcell image { width: 100%; height: 100%; }
.covadd {
  display: flex; flex-direction: column; align-items: center; justify-content: center;
  color: #5B6470; font-size: 34rpx; border: 2rpx dashed #C9D4E4; box-sizing: border-box;
}
.covadd text { font-size: 20rpx; color: #8a8f99; margin-top: 4rpx; }
.covcancel { text-align: center; font-size: 27rpx; color: #5B6470; padding: 26rpx 0 6rpx; }
