<view class="search">搜索猫咪名字或昵称</view>

<view class="tabs">
  <view class="t {{active==='on'?'on':''}}" bindtap="setTab" data-s="on">在校</view>
  <view class="t {{active==='ad'?'on':''}}" bindtap="setTab" data-s="ad">毕业</view>
  <view class="t {{active==='mi'?'on':''}}" bindtap="setTab" data-s="mi">休学</view>
  <view class="t {{active==='de'?'on':''}}" bindtap="setTab" data-s="de">喵星</view>
</view>

<view wx:if="{{list.length===0}}" class="muted" style="text-align:center;padding:40rpx 0;">该分类下还没有猫咪</view>

<view wx:for="{{list}}" wx:key="id" class="card" bindtap="goDetail" data-id="{{item.id}}">
  <view class="avatar" style="background:{{item.bg}}">{{item.photoText}}</view>
  <view>
    <view class="nm">{{item.name}}<text wx:if="{{item.isAdoptable}}" class="badge">待领养</text></view>
    <view class="sub">{{item.sub}}</view>
  </view>
</view>
