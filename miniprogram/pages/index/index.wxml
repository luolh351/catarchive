<!-- 假搜索框：点击进入独立搜索页（返回键/手势自动回首页） -->
<view class="search fake" bindtap="goSearch">🔍 搜索猫咪名字 / 常出没</view>

<view class="tabs">
  <view class="t {{active==='在校'?'on':''}}" bindtap="setTab" data-s="在校">在校</view>
  <view class="t {{active==='毕业'?'on':''}}" bindtap="setTab" data-s="毕业">毕业</view>
  <view class="t {{active==='休学'?'on':''}}" bindtap="setTab" data-s="休学">休学</view>
  <view class="t {{active==='喵星'?'on':''}}" bindtap="setTab" data-s="喵星">喵星</view>
</view>

<view wx:if="{{list.length===0}}" class="muted" style="text-align:center;padding:40rpx 0;">该分类下还没有猫咪</view>

<view wx:for="{{list}}" wx:key="id" class="card" bindtap="goDetail" data-id="{{item.id}}">
  <view class="avatar" style="background:{{item.bg}}">
    <image wx:if="{{item.photo}}" class="aimg" src="{{item.photo}}" mode="aspectFill" />
    <block wx:else>{{item.photoText}}</block>
  </view>
  <view class="info">
    <view class="nm">{{item.name}}<text wx:if="{{item.isAdoptable}}" class="badge">待领养</text></view>
    <view class="sub">{{item.sub}}</view>
  </view>
</view>

<!-- 数量统计：紧跟最后一张卡片下方 -->
<view wx:if="{{list.length>0}}" class="footcount">{{active}}共有 {{list.length}} 只猫</view>

<!-- 随机猫：固定在列表最底下，洗牌袋规则——每次进入首页抽取一只（不放回，一轮不重复，抽完重置） -->
<view wx:if="{{daily}}" class="dailycard" bindtap="goDaily">
  <view class="davatar" style="background:{{daily.bg}}">
    <image wx:if="{{daily.photo}}" class="dimg" src="{{daily.photo}}" mode="aspectFill" />
    <block wx:else>{{daily.photoText}}</block>
  </view>
  <view class="dinfo">
    <view class="dt">今天随机认识一只猫咪</view>
    <view class="ds">{{daily.name}} · 点它认识一下</view>
  </view>
  <view class="darrow">›</view>
</view>

<!-- 猫咪星标榜单入口。 -->
<view class="rankfab" bindtap="goRank" hover-class="rankfab-pressed" aria-role="button" aria-label="打开猫咪榜单">
  <image class="rankfab-icon" src="/assets/icons/cat-star.svg" mode="aspectFit" />
</view>

<!-- 简洁榜单：数字排名、细线标签、右侧计数。 -->
<view wx:if="{{rankShow}}" class="rankmask" bindtap="closeRank">
  <view class="ranksheet" catchtap="stop">
    <view class="rh">风云猫子<text class="rx" catchtap="closeRank">×</text></view>
    <view class="rtabs">
      <view class="rtab {{rankTab==='like'?'on':''}}" bindtap="setRankTab" data-t="like">点赞榜</view>
      <view class="rtab {{rankTab==='hot'?'on':''}}" bindtap="setRankTab" data-t="hot">人气榜</view>
    </view>
    <view class="rank-column-label">{{rankTab==='like'?'点赞数':'浏览次数'}}</view>
    <scroll-view scroll-y class="rlist">
      <view wx:if="{{rankList.length===0}}" class="rempty">暂无猫咪数据</view>
      <view wx:for="{{rankList}}" wx:key="id" class="rrow" bindtap="goRankDetail" data-id="{{item.id}}">
        <view class="rrank {{item.rank<=3?'top':''}}">{{item.rank}}</view>
        <view class="ravatar">
          <image wx:if="{{item.photo}}" class="rimg" src="{{item.photo}}" mode="aspectFill" />
          <block wx:else>{{item.initial}}</block>
        </view>
        <view class="rname">{{item.name}}</view>
        <view class="rcnt">{{item.count}}</view>
      </view>
    </scroll-view>
  </view>
</view>
