/* 首页样式复用 app.wxss 公共类；搜索入口用全局 .search，点击跳转搜索页 */

/* 分类末尾的数量统计小字 */
.footcount { text-align: center; font-size: 22rpx; color: #9AA3AD; padding: 8rpx 0 30rpx; }

/* 今日随机猫卡片：蓝色横幅，圆形封面在左、引导文字在右（与普通卡片同形态） */
.dailycard {
  margin: 8rpx 24rpx 30rpx; padding: 24rpx 28rpx;
  border-radius: 28rpx;
  background: linear-gradient(135deg, #7AA6E8, #5B8FD9);
  box-shadow: 0 10rpx 26rpx rgba(91, 143, 217, .3);
  display: flex; align-items: center;
}
.davatar {
  width: 108rpx; height: 108rpx; border-radius: 50%;
  flex-shrink: 0; overflow: hidden;
  border: 4rpx solid rgba(255, 255, 255, .85);
  display: flex; align-items: center; justify-content: center;
  color: #fff; font-size: 40rpx; font-weight: 600;
}
.dimg { width: 100%; height: 100%; }
.dinfo { flex: 1; min-width: 0; margin-left: 24rpx; }
.dt { color: #fff; font-size: 30rpx; font-weight: 600; }
.ds { color: rgba(255, 255, 255, .85); font-size: 24rpx; margin-top: 6rpx; }
.darrow { color: rgba(255, 255, 255, .8); font-size: 44rpx; margin-left: 8rpx; }
.dailycard:active { opacity: .88; }

/* B 方案：蓝色猫咪轮廓与星标，白色圆形点击区域。 */
.rankfab {
  position: fixed; right: 24rpx; bottom: calc(25vh - 24rpx); z-index: 80;
  width: 96rpx; height: 96rpx; box-sizing: border-box;
  display: flex; align-items: center; justify-content: center;
  background: #fff; border: 2rpx solid #DCE5F2; border-radius: 50%;
  box-shadow: 0 6rpx 18rpx rgba(60, 88, 130, .14);
}
.rankfab-icon { display: block; width: 60rpx; height: 60rpx; }
.rankfab-pressed { opacity: .7; }

/* 风云猫子弹窗：白卡片居中弹层 + 半透明遮罩 */
.rankmask {
  position: fixed; left: 0; right: 0; top: 0; bottom: 0;
  background: rgba(31, 43, 61, .36); z-index: 500;
  display: flex; align-items: center; justify-content: center;
}
.ranksheet {
  width: calc(100vw - 64rpx); max-width: 686rpx; max-height: 80vh; box-sizing: border-box;
  background: #fff; border-radius: 32rpx;
  padding: 36rpx 32rpx 16rpx;
  display: flex; flex-direction: column;
  box-shadow: 0 16rpx 56rpx rgba(31, 43, 61, .12);
}
.rh {
  text-align: left; font-size: 34rpx; font-weight: 600; color: #283343;
  position: relative; padding: 0 64rpx 28rpx 4rpx;
}
.rx { position: absolute; right: -8rpx; top: -16rpx; font-size: 40rpx; color: #929BA8; font-weight: 400; padding: 8rpx 16rpx; }
.rtabs { display: flex; border-bottom: 1rpx solid #E9EDF3; }
.rtab {
  flex: 1; position: relative; text-align: center;
  font-size: 28rpx; line-height: 1.5; color: #929BA8; padding: 16rpx 0 20rpx;
}
.rtab.on { color: #5079C6; font-weight: 600; }
.rtab.on::after { content: ''; position: absolute; left: 28%; right: 28%; bottom: 0; height: 4rpx; border-radius: 4rpx; background: #5079C6; }
.rank-column-label { text-align: right; color: #929BA8; font-size: 22rpx; padding: 20rpx 4rpx 4rpx; }
.rlist { flex: 1; min-height: 0; height: 54vh; max-height: 54vh; }
.rempty { text-align: center; color: #9AA3AD; font-size: 26rpx; padding: 60rpx 0; }
.rrow {
  display: flex; align-items: center;
  padding: 22rpx 4rpx;
  border-bottom: 1rpx solid #EDF0F5;
}
.rrow:last-child { border-bottom: none; }
.rrank {
  width: 40rpx; flex-shrink: 0;
  color: #929BA8;
  display: flex; align-items: center; justify-content: center;
  font-size: 28rpx; font-weight: 500;
}
.rrank.top { color: #5079C6; font-weight: 600; }
.ravatar {
  width: 76rpx; height: 76rpx; border-radius: 50%;
  margin: 0 20rpx 0 12rpx; overflow: hidden; flex-shrink: 0;
  display: flex; align-items: center; justify-content: center;
  background: #EDF2F9; color: #7489A9; font-size: 30rpx; font-weight: 500;
}
.rimg { width: 100%; height: 100%; }
.rname { flex: 1; min-width: 0; padding-right: 16rpx; font-size: 28rpx; line-height: 1.5; color: #283343; font-weight: 400; overflow-wrap: break-word; word-break: break-all; }
.rcnt { max-width: 40%; font-size: 28rpx; line-height: 1.5; color: #596271; font-weight: 500; flex-shrink: 0; overflow-wrap: break-word; word-break: break-all; }
.rrow:active { background: #FAFBFC; }
