/* 首页样式复用 app.wxss 公共类；搜索入口用全局 .search，点击跳转搜索页 */

/* 分类末尾的数量统计小字 */
.footcount { text-align: center; font-size: 22rpx; color: #9AA3AD; padding: 8rpx 0 30rpx; }

/* 今日随机猫卡片：蓝色横幅，圆形封面在左、引导文字在右（与普通卡片同形态） */
.dailycard {
  margin: 8rpx 24rpx 30rpx; padding: 24rpx 28rpx;
  border-radius: 28rpx;
  background: linear-gradient(135deg, #7AA6E8, #5B8FD9);
  box-shadow: 0 10rpx 26rpx rgba(91, 143, 217, .3);
  display: flex; align-items: center;
}
.davatar {
  width: 108rpx; height: 108rpx; border-radius: 50%;
  flex-shrink: 0; overflow: hidden;
  border: 4rpx solid rgba(255, 255, 255, .85);
  display: flex; align-items: center; justify-content: center;
  color: #fff; font-size: 40rpx; font-weight: 600;
}
.dimg { width: 100%; height: 100%; }
.dinfo { flex: 1; min-width: 0; margin-left: 24rpx; }
.dt { color: #fff; font-size: 30rpx; font-weight: 600; }
.ds { color: rgba(255, 255, 255, .85); font-size: 24rpx; margin-top: 6rpx; }
.darrow { color: rgba(255, 255, 255, .8); font-size: 44rpx; margin-left: 8rpx; }
.dailycard:active { opacity: .88; }

/* 人气榜浮游入口：右侧、屏幕约 3/4 高度处（离底部 1/4 屏），暖橙胶囊 */
.rankfab {
  position: fixed; right: 24rpx; bottom: calc(100vh / 4); z-index: 80;
  padding: 16rpx 30rpx; border-radius: 999rpx;
  background: linear-gradient(135deg, #FFD59E, #FFB46B);
  color: #7A4A12; font-size: 26rpx; font-weight: 600;
  box-shadow: 0 8rpx 22rpx rgba(255, 180, 107, .45);
}
.rankfab:active { opacity: .85; }

/* 风云猫子弹窗：白卡片居中弹层 + 半透明遮罩 */
.rankmask {
  position: fixed; left: 0; right: 0; top: 0; bottom: 0;
  background: rgba(0, 0, 0, .45); z-index: 500;
  display: flex; align-items: center; justify-content: center;
}
.ranksheet {
  width: 640rpx; max-height: 76vh;
  background: #fff; border-radius: 28rpx;
  padding: 32rpx 32rpx 24rpx;
  display: flex; flex-direction: column;
  box-shadow: 0 20rpx 60rpx rgba(0, 0, 0, .18);
}
.rh {
  text-align: center; font-size: 34rpx; font-weight: 700; color: #333;
  position: relative; padding-bottom: 20rpx;
}
.rx { position: absolute; right: 0; top: -6rpx; font-size: 40rpx; color: #B8BEC6; font-weight: 400; padding: 0 8rpx; }
.rtabs { display: flex; justify-content: center; gap: 16rpx; padding-bottom: 20rpx; }
.rtab {
  font-size: 26rpx; color: #9AA3AD; padding: 10rpx 30rpx;
  border-radius: 999rpx;
}
.rtab.on { color: #E56A77; background: #FDEEF0; font-weight: 600; }
.rlist { flex: 1; max-height: 56vh; }
.rempty { text-align: center; color: #9AA3AD; font-size: 26rpx; padding: 60rpx 0; }
.rrow {
  display: flex; align-items: center;
  padding: 18rpx 4rpx;
  border-bottom: 1rpx solid #F2F4F7;
}
.rrow:last-child { border-bottom: none; }
.rrank {
  width: 48rpx; height: 48rpx; border-radius: 50%; flex-shrink: 0;
  background: #EFF1F4; color: #9AA3AD;
  display: flex; align-items: center; justify-content: center;
  font-size: 24rpx; font-weight: 700;
}
.rrank.top { background: #F0852E; color: #fff; font-size: 26rpx; }
.ravatar {
  width: 76rpx; height: 76rpx; border-radius: 50%;
  margin: 0 20rpx; overflow: hidden; flex-shrink: 0;
  display: flex; align-items: center; justify-content: center;
  color: #fff; font-size: 30rpx; font-weight: 600;
}
.rimg { width: 100%; height: 100%; }
.rname { flex: 1; min-width: 0; font-size: 28rpx; color: #333; font-weight: 500; }
.rcnt { font-size: 28rpx; color: #333; font-weight: 700; flex-shrink: 0; }
.rrow:active { background: #FAFBFC; }
