/* 科普页：子 tab 用主题蓝（与全局 tabBar/选中色一致），插图圆角横幅 */
.stabs {
  display: flex; justify-content: space-around; align-items: center;
  background: #fff; padding: 0 16rpx;
  border-bottom: 1rpx solid #EDF0F5;
}
.stab {
  position: relative; padding: 24rpx 8rpx;
  font-size: 30rpx; color: #9AA3AD;
}
.stab.on { color: #2F6FDB; font-weight: 600; }
.stab.on::after {
  content: ''; position: absolute; left: 50%; bottom: 0;
  transform: translateX(-50%);
  width: 64rpx; height: 6rpx; border-radius: 3rpx;
  background: #2F6FDB;
}

.sbody { padding: 24rpx; }
.spanel { background: var(--card, #fff); border-radius: 24rpx; overflow: hidden; box-shadow: 0 6rpx 18rpx rgba(47, 111, 219, .06); }
.shero { width: 100%; height: 400rpx; display: block; }

/* 主题主标题与引言（叠在插图下方的头部区） */
.stitle { font-size: 34rpx; font-weight: 700; color: #2F3B4C; padding: 26rpx 28rpx 0; }
.sintro { font-size: 26rpx; line-height: 1.75; color: #6B7686; padding: 12rpx 28rpx 26rpx; }

/* 正文小节 */
.scontent { margin-top: 24rpx; padding: 10rpx 28rpx 28rpx; }
.ssec { padding: 20rpx 0 4rpx; }
.ssec-t {
  font-size: 30rpx; font-weight: 700; color: #2F6FDB;
  padding-bottom: 8rpx;
}
.sblock { padding: 6rpx 0; }
.sb-h { font-size: 28rpx; font-weight: 600; color: #2F3B4C; padding: 8rpx 0 4rpx; }
.sb-p { font-size: 27rpx; line-height: 1.8; color: #4A5560; padding: 4rpx 0; text-align: justify; }
