/* 科普页：子 tab 用主题蓝（与全局 tabBar/选中色一致），插图圆角横幅 */
.stabs {
  display: flex; justify-content: space-around; align-items: center;
  background: #fff; padding: 0 16rpx;
  border-bottom: 1rpx solid #EDF0F5;
}
.stab {
  position: relative; padding: 24rpx 8rpx;
  font-size: 30rpx; color: #9AA3AD;
}
.stab.on { color: #2F6FDB; font-weight: 600; }
.stab.on::after {
  content: ''; position: absolute; left: 50%; bottom: 0;
  transform: translateX(-50%);
  width: 64rpx; height: 6rpx; border-radius: 3rpx;
  background: #2F6FDB;
}

.sbody { padding: 24rpx; }
.spanel { background: var(--card, #fff); border-radius: 24rpx; overflow: hidden; box-shadow: 0 6rpx 18rpx rgba(47, 111, 219, .06); }
.shero { width: 100%; height: 400rpx; display: block; }
