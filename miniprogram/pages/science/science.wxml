<!-- 科普页：顶部子 tab + 主题插图 + 结构化图文内容 -->
<view class="stabs">
  <view
    wx:for="{{tabs}}"
    wx:key="key"
    class="stab {{tab===item.key?'on':''}}"
    bindtap="setTab"
    data-key="{{item.key}}"
  >{{item.name}}</view>
</view>

<view class="sbody" wx:if="{{cur}}">
  <!-- 主题横幅插图 -->
  <view class="spanel">
    <image class="shero" src="{{cur.img}}" mode="aspectFill" />
    <view class="stitle">{{cur.content.title}}</view>
    <view class="sintro">{{cur.content.intro}}</view>
  </view>

  <!-- 小节内容：t 为节标题（可空），blocks 内 h 为条目小标题、ps 为段落 -->
  <view class="spanel scontent">
    <view class="ssec" wx:for="{{cur.content.sections}}" wx:for-item="sec" wx:key="t">
      <view wx:if="{{sec.t}}" class="ssec-t">{{sec.t}}</view>
      <view class="sblock" wx:for="{{sec.blocks}}" wx:for-item="b" wx:key="index">
        <view wx:if="{{b.h}}" class="sb-h">{{b.h}}</view>
        <view class="sb-p" wx:for="{{b.ps}}" wx:for-item="p" wx:key="*this">{{p}}</view>
      </view>
    </view>
  </view>
</view>
