<!-- 封面裁剪：固定比例取景（首页圆形 1:1 / 卡片横向 15:8）。
     图片可拖动/双指缩放，边界严格钳制（图片永远盖住取景框，不会拖出框外）；
     圆形封面时取景框显示为圆形亮框，圆外（含四角）压暗，所见即所得 -->
<view class="crop-page">
  <view class="cropwrap" style="width:{{vw}}px;height:{{vh}}px">
    <view class="cropview {{target === 'card' ? 'card' : ''}}"
      catchtouchstart="onTouchStart" catchtouchmove="onTouchMove" catchtouchend="onTouchEnd">
      <image class="cimg" src="{{src}}" mode="scaleToFill"
        style="width:{{bw}}px;height:{{bh}}px;transform:translate({{tx}}px,{{ty}}px) scale({{s}});transform-origin:0 0;" />
    </view>
    <!-- 压暗遮罩：圆形封面=圆外全暗；卡片封面=取景框外全暗。放在 overflow 容器外，阴影不被裁剪 -->
    <view class="mask {{target === 'home' ? 'round' : ''}}"></view>
  </view>

  <view class="crophint">
    <view>拖动或双指缩放图片，让想显示的部分落在亮框内。</view>
    <view>不调整直接确认＝取中间区域。</view>
  </view>

  <view class="cropbtns">
    <view class="cbtn ghost" bindtap="cancel">取消</view>
    <view class="cbtn primary {{exporting ? 'disabled' : ''}}" bindtap="confirm">{{exporting ? '生成中…' : '确认封面'}}</view>
  </view>

  <!-- 导出用画布：置于屏幕外 -->
  <canvas type="2d" id="cropCanvas" class="offscreen"></canvas>
</view>
