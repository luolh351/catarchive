<!-- 封面裁剪（canvas 自绘方案）：
     - 预览与导出共用同一套坐标计算，所见即所得；
     - 首页圆形：canvas 内绘制圆形取景（圆外压暗 + 白色圆环）；
     - 卡片横向：15:8 矩形取景；
     - 手势直接重绘画布（无 setData），拖动/双指缩放流畅，且严格限制边界 -->
<view class="crop-page">
  <view class="cropbox {{target === 'home' ? 'round' : ''}}" style="width:{{vw}}px;height:{{vh}}px">
    <canvas type="2d" id="cropView" class="cview"
      style="width:{{vw}}px;height:{{vh}}px"
      catchtouchstart="onTouchStart"
      catchtouchmove="onTouchMove"
      catchtouchend="onTouchEnd"
      catchtouchcancel="onTouchEnd"></canvas>
  </view>

  <view class="crophint">
    <view>单指拖动 · 双指缩放，让想显示的部分落在亮框内。</view>
    <view>不调整直接确认＝取中间区域。</view>
  </view>

  <view class="cropbtns">
    <view class="cbtn ghost" bindtap="cancel">取消</view>
    <view class="cbtn primary {{(exporting || !ready) ? 'disabled' : ''}}" bindtap="confirm">{{exporting ? '生成中…' : (!ready ? '图片加载中…' : '确认封面')}}</view>
  </view>
</view>
