/* 人气榜页面样式 */
.h { font-size: 40rpx; font-weight: 700; padding: 24rpx 8rpx 4rpx; }
.sub { font-size: 24rpx; color: var(--sub); padding: 0 8rpx 20rpx; }

.row {
  display: flex; align-items: center;
  background: var(--card); border-radius: 24rpx;
  padding: 20rpx 24rpx; margin: 16rpx 0;
  box-shadow: 0 6rpx 18rpx rgba(47,111,219,.06);
}
.rank {
  width: 56rpx; text-align: center; flex-shrink: 0;
  font-size: 30rpx; font-weight: 700; color: var(--sub);
}
.rank.top { font-size: 40rpx; }
.avatar {
  width: 88rpx; height: 88rpx; border-radius: 50%;
  margin-left: 8rpx; overflow: hidden; flex-shrink: 0;
  display: flex; align-items: center; justify-content: center;
  color: #fff; font-size: 34rpx; font-weight: 600;
}
.aimg { width: 100%; height: 100%; }
.info { flex: 1; min-width: 0; margin-left: 20rpx; }
.nm { font-size: 30rpx; font-weight: 600; }
.cnt { font-size: 28rpx; color: #E56A77; font-weight: 600; flex-shrink: 0; }
.row:active { opacity: .85; }
