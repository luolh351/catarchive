<view class="h">🏆 人气榜</view>
<view class="sub">按被点赞总数排序 · 详情页可点赞（每人每天 3 次）</view>

<view wx:if="{{loading}}" class="muted" style="text-align:center;padding:60rpx 0;">加载中…</view>
<view wx:elif="{{list.length===0}}" class="muted" style="text-align:center;padding:60rpx 0;">还没有猫咪上榜，快去给喜欢的猫点个赞吧</view>

<view wx:for="{{list}}" wx:key="id" class="row" bindtap="goDetail" data-id="{{item.id}}">
  <view class="rank {{item.rank<=3?'top':''}}">{{item.medal || item.rank}}</view>
  <view class="avatar" style="background:linear-gradient(135deg,#FFD59E,#FFB46B)">
    <image wx:if="{{item.photo}}" class="aimg" src="{{item.photo}}" mode="aspectFill" />
    <block wx:else>{{item.initial}}</block>
  </view>
  <view class="info">
    <view class="nm">{{item.name}}</view>
  </view>
  <view class="cnt">❤ {{item.likeCount}}</view>
</view>
