/* 详情页为公开只读视图，无管理操作样式 */
.heroimg { width: 100%; height: 100%; display: block; }
.gallery { display: flex; gap: 12rpx; overflow-x: auto; margin-top: 16rpx; }
.gimg { width: 200rpx; height: 200rpx; border-radius: 20rpx; flex: 0 0 200rpx; }
.media { background: var(--card); border-radius: 28rpx; padding: 24rpx 28rpx; margin: 24rpx 0; box-shadow: 0 6rpx 20rpx rgba(47,111,219,.06); }
.mlab { font-size: 24rpx; color: var(--sub); margin-bottom: 16rpx; }
.vbtn {
  background: var(--primary); color: #fff; text-align: center;
  padding: 20rpx 0; border-radius: 24rpx; font-size: 28rpx;
}
/* 页内分享：button 需去掉默认边框背景，小按钮右对齐 */
.sharerow { display: flex; align-items: center; justify-content: flex-end; gap: 16rpx; padding: 0 4rpx; }
.sharebtn {
  display: inline-flex; align-items: center; justify-content: center;
  font-size: 26rpx; color: var(--primary); border: 1rpx solid var(--primary);
  border-radius: 999rpx; padding: 8rpx 26rpx; line-height: 1.4; margin: 0;
  background: transparent;
}
.sharebtn::after { border: none; }
.sharehint { font-size: 22rpx; color: var(--sub); }
/* 近况时间线里的配图 */
.tlimgs { display: flex; flex-wrap: wrap; margin-top: 14rpx; }
.tlimg { width: 160rpx; height: 160rpx; border-radius: 16rpx; margin: 0 12rpx 12rpx 0; }
.vempty {
  background: #F4F6FA; color: #97A0AA; text-align: center;
  padding: 20rpx 0; border-radius: 24rpx; font-size: 26rpx;
  border: 1rpx dashed #C9D4E4;
}
