/* 详情页为公开只读视图，无管理操作样式 */
.heroimg { width: 100%; height: 100%; display: block; }
.gallery { display: flex; gap: 12rpx; overflow-x: auto; margin-top: 16rpx; }
.gimg { width: 200rpx; height: 200rpx; border-radius: 20rpx; flex: 0 0 200rpx; }
.media { background: var(--card); border-radius: 28rpx; padding: 24rpx 28rpx; margin: 24rpx 0; box-shadow: 0 6rpx 20rpx rgba(47,111,219,.06); }
.mlab { font-size: 24rpx; color: var(--sub); margin-bottom: 16rpx; }
.vbtn {
  background: var(--primary); color: #fff; text-align: center;
  padding: 20rpx 0; border-radius: 24rpx; font-size: 28rpx;
}
/* 页内分享：button 需去掉默认边框背景，小按钮右对齐 */
.sharerow { display: flex; align-items: center; justify-content: flex-end; gap: 16rpx; padding: 0 4rpx; }
.sharebtn {
  display: inline-flex; align-items: center; justify-content: center;
  font-size: 26rpx; color: var(--primary); border: 1rpx solid var(--primary);
  border-radius: 999rpx; padding: 8rpx 26rpx; line-height: 1.4; margin: 0;
  background: transparent;
}
.sharebtn::after { border: none; }
.sharehint { font-size: 22rpx; color: var(--sub); }
/* 照片墙：一屏 3 张，swiper 翻页（高度须显式设定，含圆点空间） */
.gwrap { margin-top: 20rpx; }
.gswiper { height: 300rpx; }
.gpage { display: flex; gap: 12rpx; padding: 0 24rpx; }
.gcell { flex: 1; height: 240rpx; border-radius: 20rpx; }
.ghint { text-align: center; font-size: 22rpx; color: var(--sub); padding-top: 10rpx; }

/* 全屏照片查看层 */
.viewer { position: fixed; left: 0; right: 0; top: 0; bottom: 0; background: rgba(0,0,0,.92); z-index: 999; }
.vswiper { width: 100%; height: 100%; }
.vimg { width: 100%; height: 100%; }
.vbar { position: absolute; left: 0; right: 0; bottom: 60rpx; display: flex; align-items: center; justify-content: space-between; padding: 0 48rpx; }
.vcount { color: #fff; font-size: 28rpx; }
/* 左右切换箭头：半透明淡黑圆钮 */
.vnav {
  position: absolute; top: 50%; margin-top: -50rpx;
  width: 76rpx; height: 76rpx; border-radius: 50%;
  display: flex; align-items: center; justify-content: center;
  background: rgba(0,0,0,.32); color: rgba(255,255,255,.9);
  font-size: 74rpx; line-height: 1; padding-bottom: 10rpx;
}
.vnav.left { left: 24rpx; }
.vnav.right { right: 24rpx; }
.vsave {
  color: #fff; font-size: 28rpx; font-weight: 600;
  background: rgba(255,255,255,.3);
  border: 1rpx solid #fff;
  border-radius: 999rpx; padding: 10rpx 36rpx; line-height: 1.4; margin: 0;
}
.vsave::after { border: none; }

/* 近况时间线里的配图 */
.tlimgs { display: flex; flex-wrap: wrap; margin-top: 14rpx; }
.tlimg { width: 160rpx; height: 160rpx; border-radius: 16rpx; margin: 0 12rpx 12rpx 0; }
.vempty {
  background: #F4F6FA; color: #97A0AA; text-align: center;
  padding: 20rpx 0; border-radius: 24rpx; font-size: 26rpx;
  border: 1rpx dashed #C9D4E4;
}
