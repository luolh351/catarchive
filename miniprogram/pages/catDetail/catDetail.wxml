<view wx:if="{{notFound}}" class="muted" style="text-align:center;padding:80rpx 0;">猫咪不存在或已归档</view>

<block wx:else>
  <view class="hero">
    <image wx:if="{{cat.photos.length}}" class="heroimg" src="{{cat.photos[0]}}" mode="aspectFill" />
    <block wx:if="{{!cat.photos.length}}">猫咪照片</block>
  </view>

  <view class="d-name">
    {{cat.name}}
    <text wx:if="{{cat.isAdoptable}}" class="badge">待领养</text>
    <text class="statustag st-on">{{cat.statusText}}</text>
  </view>

  <view class="sharerow">
    <button class="sharebtn" open-type="share" plain>↗ 分享给朋友</button>
    <view class="sharehint">分享到朋友圈请点右上角 ···</view>
  </view>

  <view wx:if="{{cat.photos.length > 1}}" class="gallery">
    <image wx:for="{{cat.photos}}" wx:key="*this" src="{{item}}" mode="aspectFill" class="gimg" />
  </view>

  <view wx:if="{{cat.voice}}" class="media">
    <view class="mlab">叫声</view>
    <view class="vbtn" bindtap="playVoice">{{playing ? '播放中 · 点击停止' : '▶ 播放猫叫'}}</view>
  </view>
  <view wx:else class="media">
    <view class="mlab">叫声</view>
    <view class="vempty">叫声暂缺 · 若有它的录音欢迎投稿补充</view>
  </view>

  <view wx:if="{{cat.latestNote}}" class="morebox">最近情况：{{cat.latestNote}}</view>

  <view class="attrs">
    <view class="attr" wx:for="{{attrs}}" wx:key="k">
      <view class="k">{{item.k}}</view>
      <view class="v">{{item.v}}</view>
    </view>
  </view>

  <!-- 更多：一整段自由补充资料（父母、子女、独特特点等自行组织；为空时不显示） -->
  <block wx:if="{{more}}">
    <view class="section-t">更多</view>
    <view class="morebox">{{more}}</view>
  </block>

  <block wx:if="{{cat.latestPhotos.length}}">
    <view class="section-t">近况配图</view>
    <view class="gallery">
      <image wx:for="{{cat.latestPhotos}}" wx:key="*this" src="{{item}}" mode="aspectFill" class="gimg"
             data-src="{{item}}" data-list="{{cat.latestPhotos}}" bindtap="previewPhotos" />
    </view>
  </block>

  <view class="section-t">近况时间线</view>
  <view class="tl">
    <view class="it" wx:for="{{timeline}}" wx:key="t">
      <view class="t">{{item.t}}</view>
      <view class="c">{{item.c}}</view>
      <view class="tlimgs" wx:if="{{item.photos.length}}">
        <image wx:for="{{item.photos}}" wx:for-item="p" wx:key="*this" src="{{p}}" mode="aspectFill" class="tlimg"
               data-src="{{p}}" data-list="{{item.photos}}" bindtap="previewPhotos" />
      </view>
    </view>
  </view>
</block>
