/* 管理台样式 */
.s2 { font-size: 22rpx; color: #8a8f99; margin-top: 6rpx; line-height: 1.4; }

/* 一键通过 · 同名对比视图 */
.mv-tip { font-size: 22rpx; color: var(--sub); line-height: 1.6; margin: 8rpx 0 20rpx; }
.mv-pick { display: flex; flex-direction: column; gap: 16rpx; margin-bottom: 24rpx; }
.mv-cand {
  display: flex; align-items: center; gap: 20rpx;
  border: 2rpx solid #E5EAF2; border-radius: 20rpx; padding: 16rpx;
}
.mv-cand.on { border-color: var(--primary); background: rgba(47,111,219,.05); }
.mv-cimg { width: 96rpx; height: 96rpx; border-radius: 16rpx; flex: none; }
.mv-noimg { background: var(--tagBg); color: var(--sub); display: flex; align-items: center; justify-content: center; font-size: 28rpx; }
.mv-cinfo { flex: 1; min-width: 0; }
.mv-cname { font-size: 28rpx; color: var(--fg); font-weight: 600; }
.mv-sim {
  font-size: 20rpx; color: #C77800; background: rgba(199,120,0,.1);
  border-radius: 8rpx; padding: 2rpx 10rpx; margin-left: 12rpx; font-weight: 400;
}
.mv-csub { font-size: 22rpx; color: var(--sub); margin-top: 4rpx; }
.mv-fields { display: flex; flex-direction: column; gap: 12rpx; margin-bottom: 8rpx; }
.mv-frow {
  display: flex; align-items: center; gap: 14rpx;
  background: var(--tagBg); border-radius: 16rpx; padding: 14rpx 18rpx;
}
.mv-fl { flex: none; width: 110rpx; font-size: 24rpx; color: var(--sub); }
.mv-fv { flex: 1; font-size: 24rpx; color: var(--fg); word-break: break-all; min-width: 0; }
.mv-sw {
  flex: none; font-size: 22rpx; border-radius: 999rpx; padding: 6rpx 18rpx;
  border: 1rpx solid var(--sub); color: var(--sub);
}
.mv-sw.on { border-color: var(--primary); color: var(--primary); background: rgba(47,111,219,.08); font-weight: 600; }
.mv-sw.same { border-style: dashed; opacity: .6; }
