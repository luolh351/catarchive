<view class="panel">
  <view class="h">收录概览</view>
  <view class="mstat">
    <view class="b"><view class="n">{{stats.zaixiao}}</view><view class="l">在校</view></view>
    <view class="b"><view class="n">{{stats.dailingyang}}</view><view class="l">待领养</view></view>
    <view class="b"><view class="n">{{stats.biye}}</view><view class="l">毕业</view></view>
    <view class="b"><view class="n">{{stats.xiuxue}}</view><view class="l">休学</view></view>
    <view class="b"><view class="n">{{stats.miaoxing}}</view><view class="l">喵星</view></view>
  </view>
</view>

<view class="fab" bindtap="goForm">＋ 新增猫咪档案</view>

<view class="panel" wx:if="{{subs.length}}">
  <view class="h">待审投稿（{{subs.length}}）</view>
  <view class="mrow" wx:for="{{subs}}" wx:key="id">
    <view class="l">
      <view class="n">{{item.name}}</view>
      <view class="s">{{item.coatColor}} · {{item.lifeStatus}}</view>
      <view class="s2" wx:if="{{item.latestNote}}">{{item.latestNote}}</view>
    </view>
    <view>
      <text class="mini" bindtap="viewSub" data-id="{{item.id}}">查看</text>
      <text class="mini" bindtap="rejectSub" data-id="{{item.id}}" style="margin-left:12rpx">忽略</text>
    </view>
  </view>
</view>

<view wx:if="{{detail}}" class="mask" bindtap="closeSub">
  <view class="sheet" catchtap="stop">
    <view class="sh">投稿详情</view>
    <view class="kv"><text>名字</text><view class="vw"><text class="val">{{detail.name}}</text><text class="copy" catchtap="copySub" data-copy="{{detail.name}}">复制</text></view></view>
    <view class="kv"><text>昵称</text><view class="vw"><text class="val">{{detail.aliasesText}}</text><text class="copy" catchtap="copySub" data-copy="{{detail.aliasesText}}">复制</text></view></view>
    <view class="kv"><text>毛色</text><view class="vw"><text class="val">{{detail.coatColor}}</text><text class="copy" catchtap="copySub" data-copy="{{detail.coatColor}}">复制</text></view></view>
    <view class="kv"><text>性别</text><view class="vw"><text class="val">{{detail.gender}}</text><text class="copy" catchtap="copySub" data-copy="{{detail.gender}}">复制</text></view></view>
    <view class="kv"><text>绝育</text><view class="vw"><text class="val">{{detail.sterilizationStatus}}{{detail.sterilizedAt ? ' · ' + detail.sterilizedAt : ''}}</text><text class="copy" catchtap="copySub" data-copy="{{detail.sterilizationStatus}}{{detail.sterilizedAt ? ' · ' + detail.sterilizedAt : ''}}">复制</text></view></view>
    <view class="kv"><text>常出没</text><view class="vw"><text class="val">{{detail.usualText}}</text><text class="copy" catchtap="copySub" data-copy="{{detail.usualText}}">复制</text></view></view>
    <view class="kv"><text>最近情况</text><view class="vw"><text class="val">{{detail.latestNote}}</text><text class="copy" catchtap="copySub" data-copy="{{detail.latestNote}}">复制</text></view></view>
    <view class="kv"><text>性格</text><view class="vw"><text class="val">{{detail.personalityText}}</text><text class="copy" catchtap="copySub" data-copy="{{detail.personalityText}}">复制</text></view></view>
    <view class="kv"><text>健康</text><view class="vw"><text class="val">{{detail.healthNotes}}</text><text class="copy" catchtap="copySub" data-copy="{{detail.healthNotes}}">复制</text></view></view>
    <view class="kv"><text>待领养</text><view class="vw"><text class="val">{{detail.isAdoptable ? '是' : '否'}}</text></view></view>
    <view class="kv"><text>去向</text><view class="vw"><text class="val">{{detail.lifeStatus}}</text></view></view>
    <view class="kv col" wx:if="{{detail.photos.length}}">
      <view class="vhead"><text>照片（{{detail.photos.length}}）</text><text class="copy" catchtap="saveSubPhotos">保存到相册</text></view>
      <view class="thumbs"><image wx:for="{{detail.photos}}" wx:key="*this" src="{{item}}" mode="aspectFill" class="thumb" data-src="{{item}}" catchtap="previewSubPhoto" /></view>
    </view>
    <view class="kv"><text>叫声</text><view class="vw">
      <text wx:if="{{detail.voice}}" class="val pl" bindtap="playSubVoice">{{subPlaying ? '播放中 · 点击停止' : '▶ 试听'}}</text>
      <text wx:else class="val">无</text>
      <text wx:if="{{detail.voice}}" class="copy" catchtap="shareSubVoice">转发好友</text>
    </view></view>
    <view class="kv"><text>提交人</text><view class="vw"><text class="val">{{detail.submitter}}</text><text class="copy" catchtap="copySub" data-copy="{{detail.submitter}}">复制</text></view></view>
    <view class="kv"><text>提交时间</text><view class="vw"><text class="val">{{detail.createdAtText}}</text></view></view>
    <view class="btns">
      <view class="mini" bindtap="rejectSub" data-id="{{detail.id}}">忽略</view>
      <view class="mini primary" bindtap="closeSub">关闭</view>
    </view>
  </view>
</view>

<view class="panel">
  <view class="h">猫咪管理</view>
  <view class="mrow" wx:for="{{cats}}" wx:key="id">
    <view class="l">
      <view class="n">{{item.name}}</view>
      <view class="s">{{item.s}}</view>
      <view class="s2" wx:if="{{item.latest}}">{{item.latest}}</view>
    </view>
    <view>
      <text class="mini" bindtap="goForm" data-id="{{item.id}}">编辑</text>
      <text class="mini" bindtap="addUpdate" data-id="{{item.id}}" style="margin-left:12rpx">近况</text>
      <text class="mini" bindtap="archive" data-id="{{item.id}}" style="margin-left:12rpx">归档</text>
    </view>
  </view>
</view>

<view class="panel" wx:if="{{apps.length}}">
  <view class="h">待认领申请（{{apps.length}}）</view>
  <view class="mrow" wx:for="{{apps}}" wx:key="id">
    <view class="l">
      <view class="n">{{item.realName}}</view>
      <view class="s">{{item.major}} · {{item.className}} · {{item.dorm}}</view>
      <view class="s2" wx:if="{{item.note}}">{{item.note}}</view>
    </view>
    <view>
      <text class="mini primary" bindtap="approveApp" data-id="{{item.id}}">通过</text>
      <text class="mini" bindtap="rejectApp" data-id="{{item.id}}" style="margin-left:12rpx">忽略</text>
    </view>
  </view>
</view>

<view class="panel">
  <view class="h">管理员名单（super 专属）</view>
  <view class="mrow" wx:for="{{admins}}" wx:key="openid">
    <view class="l">
      <view class="n">{{item.realName}}（{{item.roleText}}）</view>
      <view class="s">{{item.major}} · {{item.className}} · {{item.dorm}}</view>
    </view>
    <view>
      <text wx:if="{{item.canTransfer}}" class="mini" bindtap="transfer" data-id="{{item.openid}}">转让</text>
      <text wx:if="{{item.canRemove}}" class="mini" bindtap="remove" data-id="{{item.openid}}" style="margin-left:12rpx">撤权</text>
    </view>
  </view>
  <view wx:if="{{myRole==='superadmin' && noEditor}}" class="muted" style="padding:8rpx 4rpx 0">暂无其他管理员可接收转让，请先“＋ 新增管理员”。</view>
  <view class="fab" style="background:#fff;color:#2F6FDB;border:1px solid #2F6FDB" bindtap="addAdmin">＋ 新增管理员</view>
</view>

<view class="muted" style="padding:20rpx 4rpx 40rpx">提示：管理员身份与权限由云端 checkAdmin / adminAdd 等云函数校验，前端不持有 openid/角色。</view>
