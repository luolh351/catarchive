<view class="muted" style="padding:0 4rpx 16rpx;">填写资料提交申请，超级管理员审核通过后，你即可进入管理台参与维护。</view>

<view class="field">
  <view class="lab"><text class="req">*</text> 姓名</view>
  <input placeholder="如：张三" value="{{form.realName}}" bindinput="onInput" data-field="realName" />
</view>
<view class="field">
  <view class="lab"><text class="req">*</text> 专业</view>
  <input placeholder="如 计算机" value="{{form.major}}" bindinput="onInput" data-field="major" />
</view>
<view class="field">
  <view class="lab"><text class="req">*</text> 班级</view>
  <input placeholder="如 计科1班" value="{{form.className}}" bindinput="onInput" data-field="className" />
</view>
<view class="field">
  <view class="lab"><text class="req">*</text> 宿舍</view>
  <input placeholder="如 3栋" value="{{form.dorm}}" bindinput="onInput" data-field="dorm" />
</view>
<view class="field">
  <view class="lab">申请理由（可选）</view>
  <input placeholder="如：日常喂养负责人" value="{{form.note}}" bindinput="onInput" data-field="note" />
</view>

<view class="muted" style="padding:0 4rpx 16rpx;">无需填写 openid —— 提交时系统会自动识别你的微信身份。</view>

<view class="save" bindtap="submit">提交申请</view>
<view class="cancel" bindtap="cancel">取消</view>
