/* 校园猫咪档案馆 · 全局样式（方向 B · 蓝底卡片）
   设计令牌见 docs/miniapp/design-system.md，单位用 rpx（375px 画布 ≈ 750rpx）。 */

page {
  --primary: #2F6FDB;
  --bg: #E9F1FC;
  --card: #FFFFFF;
  --fg: #182A44;
  --sub: #97A0AA;
  --line: #EEF3FB;
  --tagBg: #EAF1FD;
  --tagFg: #2F6FDB;
  --red: #FF4D4F;

  background: var(--bg);
  color: var(--fg);
  font-family: -apple-system, "PingFang SC", "Microsoft YaHei", system-ui, sans-serif;
  font-size: 28rpx;
}

/* 搜索框 */
.search {
  display: flex; align-items: center; gap: 12rpx;
  background: var(--card); border-radius: 24rpx;
  padding: 20rpx 28rpx; color: var(--sub); font-size: 28rpx;
  margin-bottom: 16rpx;
  box-shadow: 0 6rpx 20rpx rgba(47,111,219,.08);
}

/* 分段状态标签 */
.tabs {
  display: flex; background: var(--card); border-radius: 28rpx;
  padding: 10rpx; margin-bottom: 24rpx;
  box-shadow: 0 6rpx 20rpx rgba(47,111,219,.08);
}
.tabs .t {
  flex: 1; text-align: center; font-size: 28rpx; color: #8B96A3;
  padding: 16rpx 0; border-radius: 20rpx;
}
.tabs .t.on { background: var(--primary); color: #fff; font-weight: 600; }

/* 列表卡片：圆形头像在左，放大且上下贴边（垂直内边距归零，直径=卡片高度） */
.card {
  display: flex; align-items: center;
  background: var(--card); border-radius: 36rpx;
  padding: 0 28rpx; margin-bottom: 24rpx; overflow: hidden;
  min-height: 128rpx;
  box-shadow: 0 10rpx 32rpx rgba(47,111,219,.08);
}
.avatar {
  width: 128rpx; height: 128rpx; border-radius: 50%; flex: 0 0 128rpx;
  display: flex; align-items: center; justify-content: center;
  color: rgba(255,255,255,.92); font-size: 34rpx;
}
.card .info { flex: 1; padding: 18rpx 0 18rpx 24rpx; display: flex; flex-direction: column; justify-content: center; }
.card .nm { font-size: 32rpx; font-weight: 600; color: var(--fg); display: flex; align-items: center; gap: 12rpx; }
.card .sub { font-size: 24rpx; color: var(--sub); margin-top: 4rpx; }

/* 徽标 / 状态标签 */
.badge {
  font-size: 20rpx; padding: 2rpx 14rpx; border-radius: 18rpx;
  background: var(--red); color: #fff;
}
.statustag { font-size: 22rpx; padding: 4rpx 18rpx; border-radius: 20rpx; }
.st-on { background: var(--tagBg); color: var(--tagFg); }
.st-ad { background: #EAFAF0; color: #2F9E4F; }
.st-mi { background: #FFF7E6; color: #D48806; }
.st-de { background: #F2F2F2; color: #8C8C8C; }

/* 详情页大图 */
.hero {
  width: 100%; height: 400rpx; border-radius: 36rpx;
  display: flex; align-items: center; justify-content: center;
  color: rgba(255,255,255,.92); font-size: 26rpx; letter-spacing: 2rpx;
  box-shadow: 0 10rpx 32rpx rgba(47,111,219,.10);
}
.d-name { font-size: 40rpx; font-weight: 700; margin: 24rpx 0 12rpx; display: flex; align-items: center; gap: 16rpx; }
.attrs { display: grid; grid-template-columns: 1fr 1fr; gap: 20rpx; margin: 16rpx 0 8rpx; }
.attr { background: var(--card); border-radius: 28rpx; padding: 20rpx 24rpx; box-shadow: 0 6rpx 20rpx rgba(47,111,219,.06); }
.attr .k { font-size: 22rpx; color: var(--sub); }
.attr .v { font-size: 28rpx; color: var(--fg); margin-top: 4rpx; }
.section-t { font-size: 28rpx; font-weight: 600; margin: 28rpx 4rpx 16rpx; }
.tl { background: var(--card); border-radius: 28rpx; padding: 20rpx 28rpx; box-shadow: 0 6rpx 20rpx rgba(47,111,219,.06); }
.tl .it { padding: 16rpx 0; border-bottom: 1px solid var(--line); }
.tl .it:last-child { border-bottom: none; }
.tl .it .t { font-size: 24rpx; color: var(--sub); }
.tl .it .c { font-size: 28rpx; margin-top: 4rpx; }

/* 面板（管理台） */
.panel { background: var(--card); border-radius: 32rpx; padding: 28rpx; margin-bottom: 24rpx; box-shadow: 0 8rpx 24rpx rgba(47,111,219,.07); }
.panel .h { font-size: 28rpx; font-weight: 600; margin-bottom: 20rpx; }
.mstat { display: flex; gap: 16rpx; }
.mstat .b { flex: 1; text-align: center; background: var(--tagBg); border-radius: 24rpx; padding: 20rpx 0; }
.mstat .b .n { font-size: 40rpx; font-weight: 700; color: var(--primary); }
.mstat .b .l { font-size: 22rpx; color: #8B96A3; }
.mrow { display: flex; align-items: center; justify-content: space-between; padding: 18rpx 0; border-bottom: 1px solid var(--line); }
.mrow:last-child { border-bottom: none; }
.mrow .l .n { font-size: 28rpx; }
.mrow .l .s { font-size: 22rpx; color: var(--sub); }
.mini { font-size: 24rpx; padding: 10rpx 20rpx; border-radius: 20rpx; border: 1px solid #D0D9E6; background: #fff; color: #34465C; }
.mini.primary { background: var(--primary); color: #fff; border-color: var(--primary); }
.fab { background: var(--primary); color: #fff; text-align: center; padding: 24rpx; border-radius: 24rpx; font-size: 30rpx; margin-top: 8rpx; }

/* 表单 */
.field { background: var(--card); border-radius: 28rpx; padding: 24rpx 28rpx; margin-bottom: 20rpx; box-shadow: 0 6rpx 20rpx rgba(47,111,219,.06); }
.field .lab { font-size: 24rpx; color: var(--sub); margin-bottom: 12rpx; }
.field .lab .req { color: var(--red); }
.field input { width: 100%; border: none; outline: none; font-size: 28rpx; color: var(--fg); padding: 8rpx 0; }
.opts { display: flex; gap: 16rpx; flex-wrap: wrap; }
.opt { font-size: 26rpx; padding: 14rpx 28rpx; border-radius: 24rpx; background: var(--tagBg); color: var(--tagFg); border: 1px solid transparent; }
.opt.on { background: var(--primary); color: #fff; }
.row2 { display: flex; align-items: center; justify-content: space-between; }
.switch { width: 92rpx; height: 52rpx; border-radius: 26rpx; background: #CDD8E6; position: relative; transition: .2s; }
.switch.on { background: var(--primary); }
.switch::after { content: ""; position: absolute; width: 44rpx; height: 44rpx; border-radius: 50%; background: #fff; top: 4rpx; left: 4rpx; }
.switch.on::after { left: 44rpx; }
.save { background: var(--primary); color: #fff; text-align: center; padding: 26rpx; border-radius: 24rpx; font-size: 30rpx; margin-top: 8rpx; }
.cancel { text-align: center; color: #8B96A3; font-size: 28rpx; padding: 24rpx; }

/* 状态页（加载/空/错误/无权限） */
.state { flex: 1; display: flex; flex-direction: column; align-items: center; justify-content: center; color: var(--sub); gap: 20rpx; padding: 0 60rpx; text-align: center; }
.state .big { font-size: 30rpx; color: #34465C; }
.err { color: var(--red); }
.retry { background: var(--primary); color: #fff; padding: 18rpx 36rpx; border-radius: 24rpx; font-size: 26rpx; }

.muted { color: var(--sub); font-size: 24rpx; }
